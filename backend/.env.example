# Meiko Agent — Backend Environment Configuration
# Copy this file to `.env` and fill in what you have. NOTHING here is required
# to boot the server — users can also paste keys live in the app's Settings screen.

APP_NAME=Meiko
ENV=development
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-this-secret-in-production-please
CORS_ORIGINS=*

# Optional: require clients to send X-API-Key header to use /api/*
MEIKO_API_KEY=

# Default provider used when a user hasn't picked one yet: nvidia | gemini | openrouter | groq | ollama | openai
DEFAULT_PROVIDER=nvidia
DEFAULT_MODEL=meta/llama-3.3-70b-instruct

# --- NVIDIA NIM (free tier: https://build.nvidia.com/) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Google Gemini (free tier: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- OpenRouter (free-tier models available: https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Groq (free tier: https://console.groq.com/keys) ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- OpenAI (paid) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Ollama (local, no key needed) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Optional: better web search via Tavily (falls back to free DuckDuckGo otherwise) ---
TAVILY_API_KEY=

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=

# --- Storage ---
DATA_DIR=./data
DB_PATH=./data/meiko.db

# --- Agent behaviour ---
MAX_AGENT_STEPS=8
MAX_TOKENS=4096
TEMPERATURE=0.7
