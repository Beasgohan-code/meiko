# Meiko Telegram Bot — environment config

# Get this from @BotFather on Telegram after /newbot
TELEGRAM_BOT_TOKEN=

# URL of your running Meiko backend (FastAPI). Use your deployed URL in production.
MEIKO_BACKEND_URL=http://localhost:8000

# Optional: if MEIKO_API_KEY is set on the backend, put the same value here
MEIKO_API_KEY=

# Optional: link to your hosted Meiko web app for the "Open Meiko Web App" button (must be HTTPS for Telegram Web Apps)
MEIKO_WEBAPP_URL=

# How often (seconds) the bot edits its "typing" message while streaming a response
EDIT_THROTTLE_SECONDS=0.9
